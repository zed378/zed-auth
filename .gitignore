# --- Secrets: never commit these (docs/SECURITY/02 §16 Secret Exposure) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Go ---
/backend/bin/
/backend/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# --- Node / frontend ---
node_modules/
.pnp
.pnp.js
dist/
build/
.next/
out/
.astro/
.docusaurus/
.cache/
*.tsbuildinfo

# --- Test / tooling output ---
/console/playwright-report/
/console/test-results/
/console/blob-report/
/console/.nyc_output/
/console/storybook-static/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# --- Local infrastructure state ---
/deploy/.volumes/
/deploy/*.local.yml

# --- End-to-end environment (scripts/e2e-up.sh) ---
#
# `.e2e.env` carries a live refresh token for the local stack. It is a
# local-development credential and still has no business in a commit: a token
# in git history is a token that outlives every rotation.
/.e2e.env
/.e2e.pids
/.e2e-demo-a.log
/.e2e-demo-b.log
/.e2e-console-build.log
