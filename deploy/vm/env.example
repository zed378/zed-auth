# Template for /etc/zed-auth/env
#
#   sudo install -m 0600 -o root -g root env.example /etc/zed-auth/env
#   sudo "$EDITOR" /etc/zed-auth/env
#
# This file holds real credentials. It is 0600, root-owned, and lives OUTSIDE
# the repository. Never commit a filled-in copy — the pre-commit hook and
# gitleaks both refuse it (deploy/SECRETS.md).
#
# Every value below must DIFFER between staging and production. PLAN/13 and
# PLAN/14 both require separate signing keys and databases per environment: a
# shared signing key means a staging token is a production token.

# --- Environment ------------------------------------------------------------
AUTH_ENV=staging                       # staging | production
AUTH_DOMAIN=auth-staging.example.com
AUTH_ACME_EMAIL=ops@example.com

# --- Image ------------------------------------------------------------------
# Pinned BY DIGEST, not by tag. A tag is mutable, so a rollback to "the same
# tag" can silently deploy different code (SECURITY/02 §15).
AUTH_IMAGE=ghcr.io/zed378/zed-auth:sha256:REPLACE_WITH_DIGEST

# --- Identity ---------------------------------------------------------------
# Must exactly match the `iss` claim and the discovery document. https only
# outside local development, and no trailing slash — both are enforced at
# startup, because a mismatch here breaks every conforming client library.
AUTH_ISSUER=https://auth-staging.example.com

# --- Signing keys -----------------------------------------------------------
# A REFERENCE, never the key itself. The resolver refuses a file that is
# group- or world-readable (P0-14).
# AUTH_JWT_SIGNING_KEY_REF was retired in P1-03. Signing keys are managed
# with `keyctl` and stored in the signing_keys table; the service refuses to
# start if this variable is still set.

# --- PostgreSQL -------------------------------------------------------------
# The service connects as auth_app: NOT the owner and NOT BYPASSRLS, so
# row-level security applies. Connecting as the owner silently disables every
# cross-tenant isolation guarantee (PLAN/08 Part B).
AUTH_POSTGRES_DSN=postgres://auth_app:REPLACE_ME@postgres:5432/auth?sslmode=disable
AUTH_POSTGRES_MAX_OPEN_CONNS=25
AUTH_POSTGRES_MAX_IDLE_CONNS=5
AUTH_POSTGRES_CONN_MAX_LIFETIME=30m

# Owner credentials. Used ONLY by the migration step, never by the service.
AUTH_POSTGRES_OWNER_PASSWORD=REPLACE_ME
AUTH_MIGRATE_DSN=postgres://auth_owner:REPLACE_ME@postgres:5432/auth?sslmode=disable

# sslmode=disable is acceptable only because Postgres is not published to the
# host and is reachable solely over the compose network. It must become
# require or verify-full the moment the database moves to another machine —
# which is exactly what the Kubernetes migration will do.

# --- Redis ------------------------------------------------------------------
AUTH_REDIS_PASSWORD=REPLACE_ME
AUTH_REDIS_ADDR=redis:6379
AUTH_REDIS_DB=0

# --- Passwords --------------------------------------------------------------
# Breached-password checking (P1-02, ADR-015).
#
# Leave it on. When the corpus service cannot be reached the password is
# accepted and the skip is audited, counted and alerted on — failing closed
# would block password changes during exactly the incident that causes people
# to change passwords. Setting this to false is the rollback path and shows up
# as `disabled` in auth_password_breach_checks_total.
AUTH_PASSWORD_BREACH_CHECK_ENABLED=true
AUTH_PASSWORD_BREACH_TIMEOUT=2s

# --- Logging ----------------------------------------------------------------
# debug is refused in production at startup: debug output across an identity
# provider is where sensitive values leak despite redaction (PLAN/13).
AUTH_LOG_LEVEL=info
AUTH_LOG_FORMAT=json

# --- Backups ----------------------------------------------------------------
# The encryption key lives OFF this machine. A backup key stored on the host
# the backup protects is not a backup key.
AUTH_BACKUP_DEST=/var/backups/zed-auth
AUTH_BACKUP_REMOTE=                    # e.g. s3://bucket/path or user@host:/path
AUTH_BACKUP_RETENTION_DAYS=30
