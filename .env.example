# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored and must stay that way. Every value here is a local-only
# placeholder — real credentials come from the secret manager in deployed
# environments and never from a file in the repository
# (PLAN/07-BACKEND-ARCHITECTURE.md § Infrastructure, SECURITY/02 §16).

# --- Environment ------------------------------------------------------------
# One of: local, staging, production.
# Each environment has its own signing keys and its own database. Production
# values are never copied into staging (PLAN/13, PLAN/14).
AUTH_ENV=local

# --- Identity ---------------------------------------------------------------
# The OIDC issuer. Must exactly match the `iss` claim in issued tokens and the
# `issuer` field of the discovery document — a mismatch breaks every conforming
# client library, and it is a classic misconfiguration.
# Must use https outside local development, and must not end with a slash.
AUTH_ISSUER=http://localhost:8080

# --- HTTP -------------------------------------------------------------------
AUTH_HTTP_ADDR=:8080
AUTH_HTTP_READ_HEADER_TIMEOUT=5s
AUTH_HTTP_READ_TIMEOUT=15s
AUTH_HTTP_WRITE_TIMEOUT=30s
AUTH_HTTP_IDLE_TIMEOUT=60s
# Bounds how long graceful shutdown waits for in-flight requests. This service
# is on the critical path of every consumer app, so dropping requests on deploy
# would surface as intermittent login failures platform-wide.
AUTH_HTTP_SHUTDOWN_TIMEOUT=20s

# --- PostgreSQL -------------------------------------------------------------
# Connects as auth_app: NOT the table owner and NOT BYPASSRLS, so row-level
# security actually applies. Connecting as the owner would silently disable
# every cross-tenant isolation guarantee (PLAN/08 Part B, P0-08).
AUTH_POSTGRES_DSN=postgres://auth_app:local_dev_only@localhost:5432/auth?sslmode=disable
AUTH_POSTGRES_MAX_OPEN_CONNS=25
AUTH_POSTGRES_MAX_IDLE_CONNS=5
AUTH_POSTGRES_CONN_MAX_LIFETIME=30m

# Migrations connect as the owner, and only ever as a separate, deliberate
# step — never implicitly at service startup (PLAN/14 § Release Process).
AUTH_MIGRATE_DSN=postgres://auth_owner:local_dev_only@localhost:5432/auth?sslmode=disable

# --- Redis ------------------------------------------------------------------
# A cache in front of PostgreSQL for sessions, plus rate-limit counters and
# short-lived authorization codes. Not a second source of truth
# (PLAN/04 § sessions).
AUTH_REDIS_ADDR=localhost:6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0

# --- Logging ----------------------------------------------------------------
# debug is refused in production: debug output across an identity provider is
# exactly where sensitive values leak into logs despite redaction (PLAN/13).
AUTH_LOG_LEVEL=debug
AUTH_LOG_FORMAT=json
